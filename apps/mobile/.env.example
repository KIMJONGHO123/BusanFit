# 웹/iOS 시뮬레이터에서 로컬 Spring Boot 서버를 사용할 때
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Android 에뮬레이터에서는 아래 주소를 사용하세요.
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# 실기기에서는 localhost 대신 개발 PC의 LAN IP를 사용하세요.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080

# TMAP JavaScript 지도 SDK 키 (앱에 포함되는 공개 클라이언트 키)
# TMAP 콘솔에서 지도 SDK 사용 권한을 활성화한 키를 .env.local에 설정하세요.
# 서버의 TMAP_APP_KEY는 자동차 경로 조회에만 사용하고 자동으로 공유하지 않습니다.
EXPO_PUBLIC_TMAP_MAP_APP_KEY=
